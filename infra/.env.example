# Set true only after explicitly accepting the Minecraft EULA.
ACCEPT_EULA=false
MC_SEED=42
MC_SERVER_CONTAINER=minecraft-harness-server
HARNESS_PROJECT=minecraft-paper
GAME_CHAT=true
WORKER1_TOKEN=replace-with-unique-random-worker-token-1
WORKER2_TOKEN=replace-with-unique-random-worker-token-2
WORKER3_TOKEN=replace-with-unique-random-worker-token-3
WORKER4_TOKEN=replace-with-unique-random-worker-token-4
SERVER_DATA_DIR=./server-data
MC_UID=1000
MC_GID=1000
BOT1_ADMIN_TOKEN=replace-with-unique-random-admin-token-1
BOT1_AGENT_TOKENS_JSON={"player1":"replace-with-unique-random-agent-token-1"}
BOT2_ADMIN_TOKEN=replace-with-unique-random-admin-token-2
BOT2_AGENT_TOKENS_JSON={"player2":"replace-with-unique-random-agent-token-2"}
BOT3_ADMIN_TOKEN=replace-with-unique-random-admin-token-3
BOT3_AGENT_TOKENS_JSON={"player3":"replace-with-unique-random-agent-token-3"}
BOT4_ADMIN_TOKEN=replace-with-unique-random-admin-token-4
BOT4_AGENT_TOKENS_JSON={"player4":"replace-with-unique-random-agent-token-4"}
# Replace these tags with inspected @sha256 digests before recording experiments.
JAVA_IMAGE=eclipse-temurin:17-jre-jammy
NODE_IMAGE=node:22-bookworm-slim
